  "methodology": {
    "fundamentalWeights": [
      {
        "name": "Banking scale",
        "weight": 20,
        "detail": "Assets, deposits and gross advances; log-scaled to limit size domination."
      },
      {
        "name": "Profitability",
        "weight": 20,
        "detail": "ROA, ROE, NIM and sustainable profit generation."
      },
      {
        "name": "Growth",
        "weight": 15,
        "detail": "Three-year and five-year CAGR, with merger adjustments."
      },
      {
        "name": "Asset quality",
        "weight": 15,
        "detail": "GNPA, NNPA, PCR, slippages and credit cost."
      },
      {
        "name": "Capital and liquidity",
        "weight": 10,
        "detail": "CRAR, CET1, Tier I and liquidity indicators."
      },
      {
        "name": "Operational efficiency",
        "weight": 10,
        "detail": "Cost-to-income and business/profit per employee."
      },
      {
        "name": "Resilience and disclosure quality",
        "weight": 10,
        "detail": "Earnings stability, concentration, provisioning and data completeness."
      }
    ],
    "investmentWeights": [
      {
        "name": "Fundamental score",
        "weight": 70
      },
      {
        "name": "Valuation",
        "weight": 15
      },
      {
        "name": "Shareholder returns",
        "weight": 15
      }
    ],
    "rules": [
      "Use standalone Indian banking operations for the primary comparison; disclose consolidated figures separately.",
      "Use audited FY22–FY26 data and reconcile restatements and mergers.",
      "Use peer-group percentile normalisation; do not compare payments banks directly with universal banks.",
      "Use the same market-cap valuation date for every listed bank.",
      "Do not impute missing financial metrics as zero.",
      "Do not publish a composite rank until all required inputs pass completeness and reconciliation checks."
    ]
  },
  "psbPilotIndex": {
    "name": "PSB FY26 Three-Factor Pilot Score",
    "status": "Calculated pilot; not the full IBPI",
    "cohort": "12 Indian public-sector banks only",
    "asOf": "31 March 2026",
    "source": "Department of Financial Services, Government of India – Banking Analytics",
    "sourceUrl": "https://www.financialservices.gov.in/banking-analytics",
    "method": "Each metric is converted to a percentile rank within the 12-bank PSB cohort. Higher values receive higher percentiles. Ties receive average ranks. The weighted contributions are summed to 100.",
    "weights": [
      {
        "key": "netProfitFY26",
        "name": "FY26 net profit (earnings scale)",
        "weight": 40,
        "direction": "higher",
        "unit": "₹ crore",
        "caveat": "Absolute net profit measures earnings scale, not profitability efficiency."
      },
      {
        "key": "crarFY26",
        "name": "FY26 CRAR",
        "weight": 30,
        "direction": "higher",
        "unit": "%",
        "caveat": "Capital adequacy is a regulatory capital-buffer measure."
      },
      {
        "key": "netProfitGrowth",
        "name": "FY26 net profit growth vs FY25",
        "weight": 30,
        "direction": "higher",
        "unit": "%",
        "caveat": "One-year growth only; not a 3-year or 5-year CAGR."
      }
    ],
